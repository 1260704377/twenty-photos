{
  "name": "twenty-photos",
  "productName": "20张",
  "version": "0.1.0",
  "description": "每天只整理 20 张照片。所有照片，都留在本机。",
  "main": "src/main/main.cjs",
  "private": true,
  "author": "20张",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac zip",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "sharp": "0.35.4",
    "heic-decode": "2.1.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "app.twentyphotos.desktop",
    "productName": "20张",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "identity": null,
      "icon": "assets/icon.png",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
